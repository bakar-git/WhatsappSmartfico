# Copy this file to .env beside the binary (or in the project for go run).
HTTP_ADDR=127.0.0.1:8080
DATA_DIR=data
# Set a per-installation token to require bearer authentication.
API_TOKEN=
# Keep the service running when its console closes (use a built binary).
BACKGROUND_ON_CLOSE=true
# Register this installed binary to start quietly at user login.
START_ON_LOGIN=true
# Checks the public GitHub Releases .release asset; no GitHub token required.
UPDATE_ENABLED=true
UPDATE_MANIFEST_URL=https://github.com/bakar-git/WhatsappSmartfico/releases/latest/download/.release
UPDATE_CHECK_INTERVAL=6h
